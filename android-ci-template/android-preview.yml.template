name: Android Preview

on:
  workflow_dispatch:

permissions:
  contents: read

env:
  APP_DIR: android-meter-app
  APK_PATH: android-meter-app/app/build/outputs/apk/debug/app-debug.apk
  PACKAGE_NAME: ru.egor.meters
  MAIN_ACTIVITY: .OcrMainActivity

jobs:
  preview:
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Setup Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle cache
        uses: gradle/actions/setup-gradle@v6
        with:
          cache-provider: basic

      - name: Build debug APK
        working-directory: ${{ env.APP_DIR }}
        run: ./gradlew :app:assembleDebug

      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm

      - name: Launch emulator and capture screenshot
        uses: ReactiveCircus/android-emulator-runner@v2.38.0
        with:
          api-level: 35
          arch: x86_64
          target: google_apis
          profile: pixel_6
          disable-animations: true
          script: |
            adb install -r "$GITHUB_WORKSPACE/${APK_PATH}"
            adb shell am force-stop "$PACKAGE_NAME"
            adb shell am start -W -n "$PACKAGE_NAME/$PACKAGE_NAME$MAIN_ACTIVITY"
            sleep 3
            mkdir -p "$GITHUB_WORKSPACE/android-preview-artifacts"
            adb exec-out screencap -p > "$GITHUB_WORKSPACE/android-preview-artifacts/home.png"

      - name: Upload preview screenshot
        uses: actions/upload-artifact@v4
        with:
          name: android-preview-screenshot
          path: android-preview-artifacts/home.png
          if-no-files-found: error
          retention-days: 7

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: android-preview-apk
          path: ${{ env.APK_PATH }}
          if-no-files-found: error
          retention-days: 7
